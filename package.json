{
  "name": "zehnnegar",
  "version": "1.0.0",
  "description": "ذهن‌نگار — تخته‌سفید و نقشهٔ ذهنی آفلاین با رابط فارسی (بر پایهٔ Drawnix)",
  "main": "./out/main/index.js",
  "author": "behroozsheikhan",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/behroozsheikhan/mindmap",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "env -u NODE_OPTIONS electron-vite dev -- --no-sandbox",
    "start": "env -u NODE_OPTIONS electron-vite preview -- --no-sandbox",
    "preview:web": "VITE_API_MOCK=1 vite --config vite.renderer.config.mts --host 0.0.0.0 --port 5173",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings=0 && node scripts/check-logical-css.mjs && npm run typecheck",
    "test": "vitest run",
    "test:db": "env -u NODE_OPTIONS ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --dir src/main/db",
    "build": "electron-vite build",
    "test:e2e": "env -u NODE_OPTIONS xvfb-run -a playwright test --reporter=line",
    "pack:win": "electron-builder --win nsis --x64 --publish never",
    "postinstall": "node scripts/patch-plait.mjs",
    "test:db:node": "ZN_DB_TESTS=1 vitest run --dir src/main/db",
    "rebuild": "env -u NODE_OPTIONS electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.39.5",
    "@floating-ui/react": "^0.26.24",
    "@plait-board/markdown-to-drawnix": "^0.0.8",
    "@plait-board/mermaid-to-drawnix": "^0.0.8",
    "@plait/common": "^0.94.0",
    "@plait/core": "^0.94.0",
    "@plait/draw": "^0.94.0",
    "@plait/layouts": "^0.94.0",
    "@plait/mind": "^0.94.0",
    "@plait/text-plugins": "^0.94.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/is-hotkey": "^0.1.10",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "ahooks": "^3.9.7",
    "browser-fs-access": "^0.38.0",
    "classnames": "^2.5.1",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.0.0",
    "is-hotkey": "^0.2.0",
    "jsdom": "~29.1.1",
    "laser-pen": "^1.0.1",
    "mobile-detect": "^1.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "roughjs": "^4.6.6",
    "sass": "^1.101.0",
    "slate": "^0.116.0",
    "slate-dom": "^0.116.0",
    "slate-history": "^0.115.0",
    "slate-react": "^0.116.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
